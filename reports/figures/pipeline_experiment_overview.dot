digraph Pipeline {

  graph [rankdir=TB, bgcolor="white", pad=0.16, nodesep=0.38, ranksep=0.42,
    splines=ortho, fontname="Arial", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#333333",
    fontname="Arial", fontsize=14, fontcolor="#202020", penwidth=0.9,
    width=2.15, height=0.65, margin="0.12,0.10"];
  edge [color="#454545", penwidth=0.9, arrowsize=0.65];

  train [label="Inner train\n285 labeled rows"];
  masks [label="Training masks\nControl / mixed policy"];
  model [label="Train CSDI\n24 trajectories", fillcolor="#edf3f8", color="#496d8b"];
  fixture [label="Denmark fixture\n103 rows; fixed noise"];
  select [label="Select checkpoints\n280 / 1,120 updates"];
  score [label="Validation scoring\nMC8 + shared controls"];
  gates [label="Validation gates\nConditioning / efficacy / numerical"];
  result [label="E5 blocked\nCanada remains sealed"];
  {rank=same; train; masks; model;}
  {rank=same; fixture; select; score;}
  {rank=same; gates; result;}
  train -> masks -> model;
  model -> select;
  fixture -> select [style=dashed];
  select -> score;
  score -> gates -> result;

}
