digraph "model_detail" {
    rankdir=TB;
    node [shape=record, fontname="monospace", fontsize=10];
    "target"  [label="Full CLR Target\n17-part composition (rank 16)\nNormalized: (z0 - mean) / scale", fillcolor="#BBDEFB", style=filled];
    "cond"    [label="Masked Raw Condition\nQuery: visible observed counts only\n17 parts x (value, mask, init, provenance)\n85-dim encoder (fixed 16-ch/4-head ref)", fillcolor="#C5E1A5", style=filled];
    "csdi"    [label="CSDICoreRework\n1-head attention, 2 layers\nDDPM reverse: 20 steps\nquad beta 1e-4 to 0.5\nFull-coordinate epsilon loss\n(all 17 latent dims)", fillcolor="#FFE082", style=filled];
    "sample"  [label="Sampling\n8 Gaussian reverse chains (MC=8)\nPer-chain: denormalize, final projection\nMean latents -> CLR inverse/softmax", fillcolor="#F8BBD0", style=filled];
    "restore" [label="Observed Restoration\nVisible-anchor scale estimate\nExact overwrite of observed counts\nScale=1 fallback if no anchor", fillcolor="#E1BEE7", style=filled];
    "contract" [label="Output Contract\nFinite, non-negative, observed-locked\nStatus=OK, 0 violations", fillcolor="#C8E6C9", style=filled];
    "target"  -> "csdi";
    "cond"    -> "csdi" [style=dashed, label="condition"];
    "csdi"    -> "sample";
    "sample"  -> "restore";
    "restore"  -> "contract";
}
