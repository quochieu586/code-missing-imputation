digraph Pipeline {

  graph [rankdir=TB, bgcolor="white", pad=0.16, nodesep=0.38, ranksep=0.42,
    splines=ortho, fontname="Arial", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#333333",
    fontname="Arial", fontsize=14, fontcolor="#202020", penwidth=0.9,
    width=2.15, height=0.65, margin="0.12,0.10"];
  edge [color="#454545", penwidth=0.9, arrowsize=0.65];

  target [label="Full CLR target\n17 coordinates; rank 16"];
  noise [label="Forward noise\nTraining / validation fixture"];
  query [label="Masked raw query\nVisible values + mask"];
  init [label="Stage A initializer\nHron / Aitchison"];
  cond [label="Condition encoder\n85 -> 16 -> 16"];
  core [label="CSDI epsilon predictor\n16 channels; 2 blocks; 1 head", fillcolor="#edf3f8", color="#496d8b"];
  loss [label="Training objective\nFull-coordinate epsilon MSE"];
  sample [label="Reverse sampling\nGaussian start; 20 steps; MC8"];
  output [label="Inverse + restoration\nExact observed counts"];
  {rank=same; target; query; init;}
  {rank=same; noise; cond;}
  {rank=same; loss; sample; output;}
  target -> noise -> core;
  query -> init -> cond -> core;
  query -> cond;
  core -> loss;
  core -> sample -> output;

}
